  document.head.appendChild(st);

  const load = document.createElement('div');
  load.id = 'cbt-load';
  load.innerHTML = '<div id="cbt-load-in"><div id="cbt-load-logo">CBT</div><div id="cbt-load-sub">SOLVER · V1</div><div id="cbt-load-bar"><div id="cbt-load-fill"></div></div><div id="cbt-load-pct">0%</div></div>';
  document.body.appendChild(load);
  let pct = 0;
  const fillEl = document.getElementById('cbt-load-fill');
  const pctEl = document.getElementById('cbt-load-pct');
  const tick = setInterval(() => {
    pct += 12 + Math.random() * 15;
    if (pct > 100) pct = 100;
    fillEl.style.width = pct + '%';
    pctEl.textContent = Math.floor(pct) + '%';
    if (pct >= 100) { clearInterval(tick); setTimeout(() => { load.remove(); boot(); }, 200); }
  }, 50);

  const pill = document.createElement('div');
  pill.id = 'cbt-pill';
