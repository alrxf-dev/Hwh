      <button class="cbt-h-b" id="MN">${I.min}</button>
      <button class="cbt-h-b" id="ST">${I.ghost}</button>
      <button class="cbt-h-b" id="CL">${I.x}</button>
    </div>
  </div>
  <div class="cbt-body">
    <div class="cbt-rail">
      <button class="cbt-tab on" data-t="solve">${I.play}<span>Solve</span></button>
      <button class="cbt-tab" data-t="explain">${I.code}<span>Data</span></button>
      <button class="cbt-tab" data-t="settings">${I.cog}<span>Conf</span></button>
      <button class="cbt-tab" data-t="log">${I.code}<span>Log</span></button>
      <button class="cbt-tab" data-t="credit">${I.heart}<span>Cred</span></button>
    </div>
    <div class="cbt-content" id="CT">
      <div class="cbt-p on" data-p="solve">
        <div class="cbt-tip" id="TIP">${I.spark}<span id="TIPTEXT">Detecting...</span></div>
        <button class="cbt-btn red" id="GO">${I.play}<span>Jawab Semua</span></button>
        <button class="cbt-btn grn" id="GOFINISH">${I.bolt}<span>Jawab + Selesai</span></button>
        <div class="cbt-g3 mb8">
          <button class="cbt-btn wht sm" id="SC">${I.scan}<span>Scan</span></button>
          <button class="cbt-btn yel sm" id="AI">${I.bolt}<span>AI Fallback</span></button>
          <button class="cbt-btn dar sm" id="RS">${I.x}<span>Clear</span></button>
        </div>
        <div class="cbt-sc" id="SCD">
          <div class="cbt-sc-t">${I.spark}<span>Hasil</span></div>
          <div class="cbt-sc-v" id="SCV">-</div>
          <div class="cbt-sc-d" id="SCDD">idle</div>
        </div>
      </div>
      <div class="cbt-p" data-p="explain">
        <div class="cbt-exl" id="EX"><div style="color:#a86a6a;font-size:10px;text-align:center;padding:20px;font-weight:700">BELUM ADA DATA</div></div>
      </div>
      <div class="cbt-p" data-p="settings">
        <div class="mb8"><div class="cbt-lbl">${I.spark}<span>AI Fallback</span></div><select class="cbt-sel" id="PR"><option value="groq">Groq</option><option value="cloudflare">Cloudflare</option><option value="xylo">XyloAPI</option><option value="openrouter">OpenRouter</option></select></div>
        <div class="mb8"><div class="cbt-lbl">${I.code}<span>Model</span></div><select class="cbt-sel" id="MD"></select></div>
        <div class="mb8" id="KEYROW"><div class="cbt-lbl">${I.bolt}<span>API Key</span></div><div class="cbt-iw"><input class="cbt-inp" id="KY" type="password"><button class="cbt-iey" id="EY">${I.eye || I.bolt}</button></div></div>
        <div class="mb8">
          <div class="cbt-sw"><div><div class="cbt-sw-t">Auto Submit</div><div class="cbt-sw-d">Kirim otomatis setelah isi</div></div><label class="cbt-tg"><input type="checkbox" id="AS"><span class="cbt-ts"></span></label></div>
          <div class="cbt-sw"><div><div class="cbt-sw-t">Auto Minimize</div><div class="cbt-sw-d">Panel kecil saat proses</div></div><label class="cbt-tg"><input type="checkbox" id="AM" checked><span class="cbt-ts"></span></label></div>
          <div class="cbt-sw"><div><div class="cbt-sw-t">Fast Mode</div><div class="cbt-sw-d">Delay antar soal 100ms</div></div><label class="cbt-tg"><input type="checkbox" id="FM" checked><span class="cbt-ts"></span></label></div>
        </div>
      </div>
      <div class="cbt-p" data-p="log">
        <div class="cbt-g2 mb8"><button class="cbt-btn wht sm" id="EXB">Export</button><button class="cbt-btn dar sm" id="CLB">Clear</button></div>
        <div class="cbt-log" id="LG"><div>Ready.</div></div>
      </div>
      <div class="cbt-p" data-p="credit">
        <div class="cbt-cr">
          <div class="cbt-cr-a">${I.user}</div>
          <div class="cbt-cr-n">Alip / Alrect</div>
          <div class="cbt-cr-r">Developer</div>
          <a class="cbt-cr-w" href="https://wa.me/6282192401340" target="_blank">${I.wa}<div class="cbt-cr-w-t"><span class="cbt-cr-w-l">Order Now</span><span class="cbt-cr-w-n">+62 821-9240-1340</span></div></a>
          <div class="cbt-cr-f">CBT SOLVER v1 · 2026</div>
        </div>
      </div>
    </div>
  </div>
  <div class="cbt-ft"><span>⚡ v1</span><span class="cbt-bg" id="FST">idle</span></div>`;
  document.body.appendChild(root);

  function boot() {
    root.style.display = 'flex';
    initHandlers();
    log('CBT Solver v1 loaded.', 'ok');
    const q = detectQuestions();
    if (q) log('✓ ' + q.length + ' soal terdeteksi', 'ai');
    else log('✗ Nggak ada soal. Buka halaman ujian dulu.', 'er');
  }

  const $ = id => document.getElementById(id);
  const qsa = (s, r) => { try { return [...(r || document).querySelectorAll(s)]; } catch { return []; } };
  const sleep = ms => new Promise(r => setTimeout(r, ms));

  const log = (m, c = 'in') => {
    const el = $('LG'); if (!el) return;
    const d = document.createElement('div');
    d.className = c; d.textContent = '[' + new Date().toLocaleTimeString() + '] ' + m;
    el.appendChild(d); el.scrollTop = el.scrollHeight;
    while (el.children.length > 500) el.removeChild(el.firstChild);
  };
  const setSt = t => { const b = $('FST'); if (!b) return; b.textContent = t; b.className = 'cbt-bg'; if (t === 'running') b.classList.add('run'); else if (t === 'error') b.classList.add('er'); else if (t === 'done') b.classList.add('dn'); };

  // ═══════════════════════════════════════════
  // DETECT QUESTIONS (from window.questions)
  // ═══════════════════════════════════════════
  function detectQuestions() {
    try {
      // Primary: global `questions` variable
      if (window.questions && Array.isArray(window.questions) && window.questions.length > 0) return window.questions;
      // Fallback: search window for any array with is_correct
      for (const k in window) {
        try {
          const v = window[k];
          if (Array.isArray(v) && v.length > 0 && v[0] && v[0].jawaban && Array.isArray(v[0].jawaban)) {
            if (v[0].jawaban[0] && 'is_correct' in v[0].jawaban[0]) return v;
          }
        } catch {}
      }
      // Fallback: parse from script tag
      const scripts = qsa('script');
      for (const s of scripts) {
        const t = s.textContent || '';
        const m = t.match(/questions\s*=\s*(\[[\s\S]*?\]);/);
        if (m) {
          try { return JSON.parse(m[1]); } catch {}
        }
      }
      return null;
    } catch { return null; }
  }

  function findCorrectOpt(q) {
    if (!q || !q.jawaban) return null;
    for (const opt of q.jawaban) {
      const c = opt.is_correct;
      if (c === '1' || c === 1 || c === true || c === 'true') return opt;
    }
    return null;
  }

  // ═══════════════════════════════════════════
  // CLICK SIMULATOR
  // ═══════════════════════════════════════════
  function simulateClick(el) {
    if (!el) return false;
    const rect = el.getBoundingClientRect();
    const cx = rect.left + rect.width / 2, cy = rect.top + rect.height / 2;
    let hit = null;
    try { hit = document.elementFromPoint(cx, cy); } catch {}
    const targets = new Set([el]);
    if (hit && hit !== el) targets.add(hit);
    const closeBtn = el.closest('label, button, [role="button"]');
    if (closeBtn) targets.add(closeBtn);
    const mk = (type, Ctor) => { try { return new Ctor(type, { bubbles: true, cancelable: true, composed: true, view: window, clientX: cx, clientY: cy, button: 0, buttons: 1 }); } catch { return null; } };
    for (const t of targets) {
      if (!t || !t.dispatchEvent) continue;
      try { t.click(); } catch {}
      try { const ev = mk('change', Event); if (ev) t.dispatchEvent(ev); } catch {}
      try { const ev = mk('input', Event); if (ev) t.dispatchEvent(ev); } catch {}
      try { const ev = mk('mousedown', MouseEvent); if (ev) t.dispatchEvent(ev); } catch {}
      try { const ev = mk('mouseup', MouseEvent); if (ev) t.dispatchEvent(ev); } catch {}
    }
    return true;
  }

  // ═══════════════════════════════════════════
  // SOLVE ALL — read from embedded data
  // ═══════════════════════════════════════════
  async function solveAll(autoFinish = false) {
    if (S.running) return;
    const Q = detectQuestions();
    if (!Q || !Q.length) { log('Nggak ada soal. Detect dulu.', 'er'); return; }

    S.running = true; setSt('running'); $('DOT').classList.add('run');
    const useAM = $('AM').checked, fast = $('FM').checked;
    if (useAM) { root.classList.add('mini'); await sleep(80); }

    log('═══ Auto-answer ' + Q.length + ' soal ═══', 'ai');
    let filled = 0, skipped = 0;
    const delay = fast ? 100 : 300;
    const exData = [];

    try {
      for (let i = 0; i < Q.length; i++) {
        const q = Q[i];
        const correct = findCorrectOpt(q);
        if (!correct) { skipped++; log('Q' + (i + 1) + ' ✗ no is_correct', 'er'); continue; }

        // Navigate to question (function goToQuestion exists in page)
        if (typeof window.goToQuestion === 'function') {
          window.goToQuestion(i);
        } else {
          const nav = document.querySelectorAll('#questionNav button');
          if (nav[i]) nav[i].click();
        }
        await sleep(delay);

        // Find the radio for this option
        const radios = qsa('#optionsContainer input[type="radio"]');
        const labels = qsa('#optionsContainer label');
        if (radios.length !== q.jawaban.length) {
          log('Q' + (i + 1) + ' ⚠ jumlah opsi mismatch: ' + radios.length + ' vs ' + q.jawaban.length, 'wn');
        }
        const idx = q.jawaban.indexOf(correct);
        if (idx >= 0 && radios[idx]) {
          simulateClick(radios[idx]);
          // Also click label for good measure
          if (labels[idx]) simulateClick(labels[idx]);
          await sleep(60);
          // Fire change event
          try {
            radios[idx].dispatchEvent(new Event('change', { bubbles: true }));
            radios[idx].dispatchEvent(new Event('input', { bubbles: true }));
          } catch {}
          filled++;
          exData.push({ idx: i + 1, answer: correct.jawaban, q: q.soal });
          log('Q' + (i + 1) + ' ✓ → ' + correct.jawaban.slice(0, 60), 'ok');
        } else {
          skipped++;
          log('Q' + (i + 1) + ' ✗ radio not found (idx=' + idx + ')', 'er');
        }
      }

      // Update result
      $('SCD').classList.add('on');
      $('SCV').textContent = filled + '/' + Q.length;
      $('SCDD').textContent = 'Skipped: ' + skipped + ' · AutoFinish: ' + (autoFinish ? 'ON' : 'OFF');
      renderExplain(exData);

      // Auto finish
      if (autoFinish) {
        log('→ Auto-submit...', 'ai');
        await sleep(800);
        if (typeof window.finishExam === 'function') {
          window.finishExam();
          log('✓ finishExam() called', 'ok');
        } else {
          const btn = document.querySelector('#finishBtn, #finishBtnMobile');
          if (btn) { btn.click(); log('✓ Finish button clicked', 'ok'); }
          else { log('✗ Finish button not found', 'er'); }
        }
      }
      setSt('done');
      log('═══ SELESAI: ' + filled + '/' + Q.length + ' ═══', 'ok');
    } catch (e) {
      log('Err: ' + e.message, 'er');
      setSt('error');
    } finally {
      S.running = false; $('DOT').classList.remove('run');
      if (useAM) setTimeout(() => root.classList.remove('mini'), 400);
    }
  }

  // ═══════════════════════════════════════════
  // AI FALLBACK — for cases where is_correct missing
  // ═══════════════════════════════════════════
  async function aiFallback() {
    if (S.running) return;
    const Q = detectQuestions();
    if (!Q || !Q.length) { log('Nggak ada soal.', 'er'); return; }
    const needsAI = Q.filter(q => !findCorrectOpt(q));
    if (!needsAI.length) { log('Semua soal udah ada jawaban. AI nggak perlu.', 'ok'); return; }

    const prov = $('PR').value, key = $('KY').value.trim();
    if (prov !== 'xylo' && !key) { log('API key kosong.', 'er'); return; }

    S.running = true; setSt('running'); $('DOT').classList.add('run');
    log('═══ AI Fallback untuk ' + needsAI.length + ' soal ═══', 'ai');
    const exData = [];
    let filled = 0;

    try {
      for (let i = 0; i < Q.length; i++) {
        const q = Q[i];
        if (findCorrectOpt(q)) continue;
        log('AI Q' + (i + 1) + '...', 'ai');
        const opts = q.jawaban.map((j, k) => (k + 1) + '. ' + j.jawaban).join('\n');
        const prompt = 'Q: ' + stripHTML(q.soal) + '\n' + opts + '\n\nReturn JSON: {"answers":[{"i":0,"a":"<EXACT option text>"}]}';
        try {
          let resp;
          if (prov === 'xylo') {
            const r = await fetch(XYLO_BASE + '?prompt=' + encodeURIComponent(prompt), { method: 'GET' });
            const d = await r.json();
            resp = d.data?.response || '';
          } else {
            const sys = 'MCQ solver. Read carefully.';
            let url, headers = { 'Content-Type': 'application/json' }, body;
            if (prov === 'groq') { url = 'https://api.groq.com/openai/v1/chat/completions'; headers.Authorization = 'Bearer ' + key; body = { model: 'openai/gpt-oss-120b', messages: [{ role: 'system', content: sys }, { role: 'user', content: prompt }], response_format: { type: 'json_object' }, temperature: 0.0, max_tokens: 500 }; }
            else if (prov === 'openrouter') { url = 'https://openrouter.ai/api/v1/chat/completions'; headers.Authorization = 'Bearer ' + key; body = { model: 'nvidia/nemotron-3-ultra-550b-a55b:free', messages: [{ role: 'system', content: sys }, { role: 'user', content: prompt }], response_format: { type: 'json_object' }, temperature: 0.0, max_tokens: 500 }; }
            else { url = 'https://api.cloudflare.com/client/v4/accounts/' + CF_ACC + '/ai/run/@cf/meta/llama-3.3-70b-instruct-fp8-fast'; headers.Authorization = 'Bearer ' + key; body = { messages: [{ role: 'system', content: sys }, { role: 'user', content: prompt }] }; }
            const r = await fetch(url, { method: 'POST', headers, body: JSON.stringify(body) });
            const d = await r.json();
            resp = prov === 'cloudflare' ? (d.result?.response || '') : (d.choices?.[0]?.message?.content || '');
          }
          // Parse
          let answer = '';
          try { const j = JSON.parse(resp.replace(/```json|```/g, '').trim()); answer = j.answers?.[0]?.a || ''; } catch {}
          if (!answer) { const m = resp.match(/[""]([^""]{2,80})[""]/); if (m) answer = m[1]; }
          // Match
          const matchIdx = q.jawaban.findIndex(j => j.jawaban.toLowerCase() === answer.toLowerCase());
          if (matchIdx >= 0) {
            if (typeof window.goToQuestion === 'function') window.goToQuestion(i);
            await sleep(300);
            const radios = qsa('#optionsContainer input[type="radio"]');
            if (radios[matchIdx]) { simulateClick(radios[matchIdx]); filled++; log('  ✓ ' + answer, 'ok'); exData.push({ idx: i + 1, answer, q: q.soal }); }
          } else { log('  ✗ no match: ' + answer, 'er'); }
        } catch (e) { log('  ✗ ' + e.message, 'er'); }
        await sleep(400);
      }
      $('SCD').classList.add('on');
      $('SCV').textContent = (filled) + ' AI';
      $('SCDD').textContent = 'Filled via AI';
      renderExplain(exData);
      setSt('done');
    } catch (e) { log('Err: ' + e.message, 'er'); setSt('error'); }
    finally { S.running = false; $('DOT').classList.remove('run'); }
  }

  const stripHTML = h => String(h || '').replace(/<[^>]*>/g, ' ').replace(/&nbsp;/g, ' ').replace(/\s+/g, ' ').trim();

  function renderExplain(data) {
    const el = $('EX'); el.innerHTML = '';
    if (!data.length) { el.innerHTML = '<div style="color:#a86a6a;font-size:10px;text-align:center;padding:20px;font-weight:700">KOSONG</div>'; return; }
    data.forEach(a => {
      const d = document.createElement('div'); d.className = 'cbt-ex';
      d.innerHTML = '<div class="cbt-ex-t">' + I.spark + ' Q' + a.idx + '</div><div class="cbt-ex-a">✓ ' + a.answer + '</div><div class="cbt-ex-r">' + stripHTML(a.q).slice(0, 140) + '</div><div class="cbt-ex-c">from embedded data</div>';
      el.appendChild(d);
    });
  }

  // ═══════════════════════════════════════════
  // INIT
  // ═══════════════════════════════════════════
  function initHandlers() {
    qsa('.cbt-tab').forEach(b => b.onclick = () => {
      qsa('.cbt-tab').forEach(x => x.classList.remove('on'));
      qsa('.cbt-p').forEach(x => x.classList.remove('on'));
      b.classList.add('on'); document.querySelector('.cbt-p[data-p="' + b.dataset.t + '"]').classList.add('on');
      $('CT').scrollTop = 0;
    });
    $('ST').onclick = () => { S.stealth = true; root.style.display = 'none'; pill.classList.add('on'); };
    $('CL').onclick = () => { root.remove(); pill.remove(); window.__CBT_LOADED__ = false; };
    $('MN').onclick = () => { const m = root.classList.toggle('mini'); $('MN').innerHTML = m ? I.max : I.min; };

    const updateModels = () => {
      const p = $('PR').value; const s = $('MD'); s.innerHTML = '';
      (MODELS[p] || []).forEach(m => { const o = document.createElement('option'); o.value = m; o.textContent = m; s.appendChild(o); });
      if (p === 'xylo') { $('KY').value = ''; $('KEYROW').style.display = 'none'; }
      else if (KEYS[p]) { $('KY').value = KEYS[p]; $('KEYROW').style.display = 'block'; }
      else { $('KY').value = ''; $('KEYROW').style.display = 'block'; }
    };
    $('PR').onchange = updateModels;

    // Drag
    const H = $('CBTH'); let dr = false, dx = 0, dy = 0;
    const sDr = (x, y) => { const r = root.getBoundingClientRect(); dr = true; dx = x - r.left; dy = y - r.top; root.style.transform = 'none'; root.style.left = r.left + 'px'; root.style.top = r.top + 'px'; };
    const mDr = (x, y) => { if (!dr) return; const r = root.getBoundingClientRect(); root.style.left = Math.max(0, Math.min(innerWidth - r.width, x - dx)) + 'px'; root.style.top = Math.max(0, Math.min(innerHeight - 40, y - dy)) + 'px'; };
    H.onmousedown = e => { if (e.target.closest('button')) return; sDr(e.clientX, e.clientY); };
    H.ontouchstart = e => { if (e.target.closest('button')) return; sDr(e.touches[0].clientX, e.touches[0].clientY); };
    document.addEventListener('mousemove', e => mDr(e.clientX, e.clientY));
    document.addEventListener('touchmove', e => { if (dr) mDr(e.touches[0].clientX, e.touches[0].clientY); });
    document.addEventListener('mouseup', () => dr = false);
    document.addEventListener('touchend', () => dr = false);

    $('SC').onclick = () => {
      const Q = detectQuestions();
      if (!Q) { log('✗ Nggak terdeteksi', 'er'); return; }
      log('═══════════════════════════════', 'in');
      log('Total: ' + Q.length + ' soal', 'ai');
      log('Source: ' + (window.questions ? 'window.questions' : 'scan'), 'ok');
      Q.slice(0, 3).forEach((q, i) => {
        const c = findCorrectOpt(q);
        log('Q' + (i + 1) + ': ' + stripHTML(q.soal).slice(0, 60), 'in');
        log('  ✓ ' + (c ? c.jawaban : '(no is_correct)'), c ? 'ok' : 'er');
      });
      if (Q.length > 3) log('... (' + (Q.length - 3) + ' more)', 'in');
      $('TIPTEXT').textContent = Q.length + ' soal · embedded answers';
    };
    $('AI').onclick = aiFallback;
    $('GO').onclick = () => solveAll(false);
    $('GOFINISH').onclick = () => solveAll(true);
    $('RS').onclick = () => { $('EX').innerHTML = ''; $('SCD').classList.remove('on'); log('Cleared.', 'wn'); };

    $('EXB').onclick = () => { const t = [...$('LG').children].map(c => c.textContent).join('\n'); const b = new Blob([t], { type: 'text/plain' }); const a = document.createElement('a'); a.href = URL.createObjectURL(b); a.download = 'cbt-log.txt'; a.click(); };
    $('CLB').onclick = () => { $('LG').innerHTML = ''; };

    document.addEventListener('keydown', e => {
      if (e.ctrlKey && e.shiftKey && e.key === 'G') {
        e.preventDefault();
        if (S.stealth) { root.style.display = 'flex'; pill.classList.remove('on'); S.stealth = false; }
        else { S.stealth = true; root.style.display = 'none'; pill.classList.add('on'); }
      }
    });

    $('PR').value = 'groq';
    updateModels();
  }
})();
